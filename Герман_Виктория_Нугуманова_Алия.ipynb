import tensorflow as tf
import numpy as np, pandas as pd, matplotlib.pyplot as plt
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error
import gradio as gr
from tensorflow import keras
import requests
from io import StringIO
from tensorflow.keras import layers


print("TF:", tf.__version__)
print("NumPy:", np.__version__)
# Блок 2. Загрузка данных солнечных пятен и базовая визуализация
def load_sunspot_data():
    # Открытый датасет месячных солнечных пятен. [web:44][web:53][web:62][web:66]
    url = "https://raw.githubusercontent.com/jbrownlee/Datasets/master/monthly-sunspots.csv"
    response = requests.get(url)
    response.raise_for_status()
    data = pd.read_csv(StringIO(response.text))
    if "Sunspots" in data.columns:
        data = data.rename(columns={"Sunspots": "SunspotNumber"})
    elif "Monthly Mean Total Sunspot Number" in data.columns:
        data = data.rename(columns={"Monthly Mean Total Sunspot Number": "SunspotNumber"})
    series = data["SunspotNumber"].astype(float).values.reshape(-1, 1)
    return data, series

raw_df, series = load_sunspot_data()
print(raw_df.head())

def plot_full_series(df):
    plt.figure(figsize=(12, 4))
    plt.plot(df.index, df["SunspotNumber"], linewidth=0.8)
    plt.title("Полный ряд месячного числа солнечных пятен")
    plt.xlabel("Индекс месяца")
    plt.ylabel("Sunspot Number")
    plt.tight_layout()
    plt.show()

def plot_zoom_series(df, start=0, end=500):
    plt.figure(figsize=(12, 4))
    sub = df.iloc[start:end]
    plt.plot(sub.index, sub["SunspotNumber"], linewidth=1.2)
    plt.title(f"Фрагмент ряда [{start}:{end}]")
    plt.xlabel("Индекс месяца")
    plt.ylabel("Sunspot Number")
    plt.tight_layout()
    plt.show()

plot_full_series(raw_df)
plot_zoom_series(raw_df, 0, 400)
# Блок 3. Нормализация и формирование обучающих окон

scaler = MinMaxScaler(feature_range=(0, 1))
series_scaled = scaler.fit_transform(series)

def train_val_test_split(data, train_ratio=0.7, val_ratio=0.15):
    n = len(data)
    i1 = int(n * train_ratio)
    i2 = int(n * (train_ratio + val_ratio))
    return data[:i1], data[i1:i2], data[i2:]

train, val, test = train_val_test_split(series_scaled)
print("Train:", len(train), "Val:", len(val), "Test:", len(test))

def create_windows(s, window_size=24, horizon=1):
    X, y = [], []
    for i in range(len(s) - window_size - horizon + 1):
        X.append(s[i:i+window_size])
        y.append(s[i+window_size:i+window_size+horizon])
    return np.array(X), np.array(y)

def plot_example_window(series_scaled, window_size=24, horizon=1):
    idx = 100
    window = series_scaled[idx:idx+window_size, 0]
    target = series_scaled[idx+window_size:idx+window_size+horizon, 0]
    plt.figure(figsize=(8, 4))
    plt.plot(range(window_size), window, label="Окно (вход)")
    plt.scatter([window_size + i for i in range(horizon)], target,
                color="red", label="Цель")
    plt.title("Пример окна и целевого значения (нормированный ряд)")
    plt.xlabel("t (шаг)")
    plt.ylabel("Нормированное значение")
    plt.legend()
    plt.tight_layout()
    plt.show()

plot_example_window(series_scaled, window_size=24, horizon=1)
# Блок 4. Построение 5 разных архитектур RNN‑моделей. [web:41][web:48][web:52][web:58][web:62][web:69][web:74]

def build_rnn_model(
    window_size=24,
    horizon=1,
    model_type="lstm",
    rnn_units=64,
    rnn_layers=1,
    dense_units=32,
    dropout=0.0,
    learning_rate=1e-3
):
    inputs = keras.Input(shape=(window_size, 1))
    x = inputs

    if model_type == "vanilla_rnn":
        for i in range(rnn_layers):
            return_sequences = (i < rnn_layers - 1) or (horizon > 1)
            x = layers.SimpleRNN(rnn_units, return_sequences=return_sequences)(x)
            if dropout > 0:
                x = layers.Dropout(dropout)(x)

    elif model_type == "lstm":
        for i in range(rnn_layers):
            return_sequences = (i < rnn_layers - 1) or (horizon > 1)
            x = layers.LSTM(rnn_units, return_sequences=return_sequences)(x)
            if dropout > 0:
                x = layers.Dropout(dropout)(x)

    elif model_type == "gru":
        for i in range(rnn_layers):
            return_sequences = (i < rnn_layers - 1) or (horizon > 1)
            x = layers.GRU(rnn_units, return_sequences=return_sequences)(x)
            if dropout > 0:
                x = layers.Dropout(dropout)(x)

    elif model_type == "cnn_lstm":
        x = layers.Conv1D(filters=32, kernel_size=3,
                          activation="relu", padding="causal")(x)
        x = layers.MaxPooling1D(pool_size=2)(x)
        x = layers.LSTM(rnn_units, return_sequences=(horizon > 1))(x)
        if dropout > 0:
            x = layers.Dropout(dropout)(x)

    elif model_type == "stacked_lstm":
        x = layers.LSTM(rnn_units, return_sequences=True)(x)
        if dropout > 0:
            x = layers.Dropout(dropout)(x)
        x = layers.LSTM(rnn_units, return_sequences=(horizon > 1))(x)
        if dropout > 0:
            x = layers.Dropout(dropout)(x)

    else:
        raise ValueError(f"Неизвестный model_type: {model_type}")

    if horizon == 1:
        x = layers.Dense(dense_units, activation="relu")(x)
        outputs = layers.Dense(1)(x)
    else:
        if len(x.shape) == 2:
            x = layers.RepeatVector(horizon)(x)
        x = layers.TimeDistributed(layers.Dense(dense_units, activation="relu"))(x)
        outputs = layers.TimeDistributed(layers.Dense(1))(x)

    model = keras.Model(inputs, outputs)
    model.compile(
        optimizer=keras.optimizers.Adam(learning_rate=learning_rate),
        loss="mse",
        metrics=[keras.metrics.RootMeanSquaredError()]
    )
    return model
# Блок 5. Визуализация обучения и прогноза

def plot_training_history(history, prefix=""):
    plt.figure(figsize=(8, 4))
    plt.plot(history["loss"], label="train_loss")
    if "val_loss" in history:
        plt.plot(history["val_loss"], label="val_loss")
    plt.title("Динамика функции потерь по эпохам")
    plt.xlabel("Эпоха")
    plt.ylabel("MSE")
    plt.legend()
    plt.tight_layout()
    path = f"{prefix}loss_history.png"
    plt.savefig(path, dpi=120)
    plt.close()
    return path

def plot_forecast(y_test_inv, y_pred_inv, prefix=""):
    N = 300
    plt.figure(figsize=(10, 4))
    plt.plot(y_test_inv[-N:], label="Истинное значение")
    plt.plot(y_pred_inv[-N:], label="Прогноз")
    plt.title("Прогноз на тестовой выборке (последние точки)")
    plt.xlabel("Индекс месяца на тесте")
    plt.ylabel("Sunspot Number")
    plt.legend()
    plt.tight_layout()
    path = f"{prefix}forecast.png"
    plt.savefig(path, dpi=120)
    plt.close()
    return path
# Блок 6. Обучение, оценка, RMSE

def train_and_evaluate(
    window_size=24,
    horizon=1,
    model_type="lstm",
    rnn_units=64,
    rnn_layers=1,
    dense_units=32,
    dropout=0.0,
    learning_rate=1e-3,
    batch_size=32,
    epochs=10
):
    X_train, y_train = create_windows(train, window_size, horizon)
    X_val, y_val = create_windows(val, window_size, horizon)
    X_test, y_test = create_windows(test, window_size, horizon)

    model = build_rnn_model(
        window_size=window_size,
        horizon=horizon,
        model_type=model_type,
        rnn_units=rnn_units,
        rnn_layers=rnn_layers,
        dense_units=dense_units,
        dropout=dropout,
        learning_rate=learning_rate
    )

    history_obj = model.fit(
        X_train, y_train,
        validation_data=(X_val, y_val),
        epochs=epochs,
        batch_size=batch_size,
        verbose=0
    )

    y_pred = model.predict(X_test, verbose=0)

    if horizon == 1:
        y_test_inv = scaler.inverse_transform(y_test.reshape(-1, 1)).flatten()
        y_pred_inv = scaler.inverse_transform(y_pred.reshape(-1, 1)).flatten()
    else:
        y_test_inv = scaler.inverse_transform(y_test.reshape(-1, 1)).reshape(y_test.shape)
        y_pred_inv = scaler.inverse_transform(y_pred.reshape(-1, 1)).reshape(y_pred.shape)
        y_test_inv = y_test_inv[:, -1, 0]
        y_pred_inv = y_pred_inv[:, -1, 0]

    rmse = np.sqrt(mean_squared_error(y_test_inv, y_pred_inv))
    loss_plot = plot_training_history(history_obj.history, prefix=f"{model_type}_")
    forecast_plot = plot_forecast(y_test_inv, y_pred_inv, prefix=f"{model_type}_")
    return forecast_plot, loss_plot, rmse, history_obj.history
# Блок 7. Текстовое объяснение и Gradio

def generate_explanation(params, rmse):
    text = f"""
Данный эксперимент выполняет прогноз месячного числа солнечных пятен по историческим данным. 
Используется одна из пяти архитектур model_type={params['model_type']} (vanilla RNN, LSTM, GRU, CNN+LSTM, stacked LSTM), 
гиперпараметры задаются пользователем, качества измеряется RMSE (сейчас {rmse:.2f}). [web:41][web:44][web:48][web:52][web:58][web:62][web:69][web:74]
"""
    return text

def run_experiment(
    window_size,
    horizon,
    model_type,
    rnn_units,
    rnn_layers,
    dense_units,
    dropout,
    learning_rate,
    batch_size,
    epochs
):
    params = {
        "window_size": int(window_size),
        "horizon": int(horizon),
        "model_type": model_type,
        "rnn_units": int(rnn_units),
        "rnn_layers": int(rnn_layers),
        "dense_units": int(dense_units),
        "dropout": float(dropout),
        "learning_rate": float(learning_rate),
        "batch_size": int(batch_size),
        "epochs": int(epochs),
    }
    forecast_path, loss_path, rmse, history = train_and_evaluate(**params)
    explanation = generate_explanation(params, rmse)
    return forecast_path, loss_path, f"RMSE на тесте: {rmse:.3f}", explanation

